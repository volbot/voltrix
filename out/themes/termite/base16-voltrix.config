color2  = #4779de # base0B - Green
color3  = #de47c5 # base0A - Yellow
color4  = #79de47 # base0D - Blue
color5  = #deac47 # base0E - Magenta
color6  = #de4779 # base0C - Cyan
color7  = #ffffff # base06 - White
color8  = #3e3e5f # base02 - Bright Black
color9  = #de4779 # base08 - Bright Red
color10 = #4779de # base0B - Bright Green
color11 = #de47c5 # base0A - Bright Yellow
color12 = #79de47 # base0D - Bright Blue
color13 = #deac47 # base0E - Bright Magenta
color14 = #de4779 # base0C - Bright Cyan
color15 = #3e3e5f # base07 - Bright White
color16 = #ac47de # base09
color17 = #47deac # base0F
color18 = #303049 # base01
color19 = #3e3e5f # base02
color20 = #8a8aa8 # base04
color21 = #ffffff # base06
