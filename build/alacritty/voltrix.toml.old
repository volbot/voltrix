# Normal colors
[colors.normal]
black   = '#0b0910'
red     = '#cd255d'
green   = '#5dcd25'
yellow  = '#cd9525'
blue    = '#255dcd'
magenta = '#9525cd'
cyan    = '#25cd95'
white   = '#b1afb6'
# Bright colors
[colors.bright]
black   = '#7d7986'
red     = '#de4779'
green   = '#79de47'
yellow  = '#deac47'
blue    = '#4779de'
magenta = '#ac47de'
cyan    = '#47deac'
white   = '#ffffff'
[colors.primary] #default
background = '#0b0910'
foreground = '#ffffff'
[colors.cursor]
cursor  = '#009845'
text    = '#ffffff'
[colors.selection]
background  = '#68228B'
text        = '#ffffff'
