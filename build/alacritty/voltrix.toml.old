# Normal colors
[colors.normal]
black   = '#0b0910'
red     = '#de4779'
green   = '#79de47'
yellow  = '#deac47'
blue    = '#4779de'
magenta = '#ac47de'
cyan    = '#47deac'
white   = '#b1afb6'
# Bright colors
[colors.bright]
black   = '#7d7986'
red     = '#ee6a96'
green   = '#96ee6a'
yellow  = '#eec26a'
blue    = '#6a96ee'
magenta = '#c26aee'
cyan    = '#6aeec2'
white   = '#ffffff'
[colors.primary] #default
background = '#0b0910'
foreground = '#ffffff'
[colors.cursor]
cursor  = '#009845'
text    = '#ffffff'
[colors.selection]
background  = '#68228B'
text        = '#ffffff'
