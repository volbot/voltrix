"type" = "blue"
"constant" = "magenta"
"constant.numeric" = "magenta"
"constant.character.escape" = "orange"
"string" = "cyan"
"string.regexp" = "red"
"comment" = "light-gray"
"variable" = "fg"
"variable.builtin" = "red"
"variable.parameter" = "fg"
"variable.other.member" = "fg"
"label" = "orange"
"punctuation" = "light-gray"
"punctuation.delimiter" = "light-gray"
"punctuation.bracket" = "fg"
"keyword" = "red"
"keyword.directive" = "magenta"
"operator" = "yellow"
"function" = "green"
"function.builtin" = "blue"
"function.macro" = "magenta"
"tag" = "yellow"
"namespace" = "blue"
"attribute" = "magenta"
"constructor" = "blue"
"module" = "blue"
"special" = "red"

"markup.heading.marker" = "light-gray"
"markup.heading.1" = { fg = "red", modifiers = ["bold"] }
"markup.heading.2" = { fg = "orange", modifiers = ["bold"] }
"markup.heading.3" = { fg = "yellow", modifiers = ["bold"] }
"markup.heading.4" = { fg = "green", modifiers = ["bold"] }
"markup.heading.5" = { fg = "blue", modifiers = ["bold"] }
"markup.heading.6" = { fg = "fg", modifiers = ["bold"] }
"markup.list" = "red"
"markup.bold" = { modifiers = ["bold"] }
"markup.italic" = { modifiers = ["italic"] }
"markup.link.url" = { fg = "blue", modifiers = ["underlined"] }
"markup.link.text" = "magenta"
"markup.quote" = "light-gray"
"markup.raw" = "green"

"diff.plus" = "green"
"diff.delta" = "orange"
"diff.minus" = "red"

"ui.background" = { bg = "bg0" }
"ui.background.separator" = "light-gray"
"ui.cursor" = { fg = "bg0", bg = "fg" }
"ui.cursor.match" = { fg = "orange", bg = "diff_yellow" }
"ui.cursor.insert" = { fg = "black", bg = "light-gray" }
"ui.cursor.select" = { fg = "bg0", bg = "blue" }
"ui.cursorline.primary" = { bg = "bg1" }
"ui.cursorline.secondary" = { bg = "bg1" }
"ui.selection" = { bg = "bg4" }
"ui.linenr" = "light-gray"
"ui.linenr.selected" = "fg"
"ui.statusline" = { fg = "fg", bg = "bg3" }
"ui.statusline.inactive" = { fg = "light-gray", bg = "bg1" }
"ui.statusline.normal" = { fg = "bg0", bg = "fg", modifiers = ["bold"] }
"ui.statusline.insert" = { fg = "bg0", bg = "yellow", modifiers = ["bold"] }
"ui.statusline.select" = { fg = "bg0", bg = "blue", modifiers = ["bold"] }
"ui.bufferline" = { fg = "light-gray", bg = "bg1" }
"ui.bufferline.active" = { fg = "fg", bg = "bg4", modifiers = ["bold"] }
"ui.popup" = { fg = "light-gray", bg = "bg2" }
"ui.window" = { fg = "light-gray", bg = "bg0" }
"ui.help" = { fg = "fg", bg = "bg2" }
"ui.text" = "fg"
"ui.text.focus" = "green"
"ui.menu" = { fg = "fg", bg = "bg3" }
"ui.menu.selected" = { fg = "bg0", bg = "green" }
"ui.virtual.whitespace" = { fg = "bg4" }
"ui.virtual.indent-guide" = { fg = "bg4" }
"ui.virtual.ruler" = { bg = "bg2" }

"hint" = "blue"
"info" = "green"
"warning" = "yellow"
"error" = "red"
"diagnostic" = { underlined = { style = "line" } }
"diagnostic.hint" = { underline = { color = "blue", style = "dotted" } }
"diagnostic.info" = { underline = { color = "green", style = "dotted" } }
"diagnostic.warning" = { underline = { color = "yellow", style = "curl" } }
"diagnostic.error" = { underline = { color = "red", style = "curl" } }
# Palette Definitions
[palette]
black   =         "#0b0910"
red     =         "#e67299"
green   =         "#99e672"
yellow  =         "#e6bf72"
blue    =         "#7299e6"
magenta =         "#bf72e6"
cyan    =         "#72e6bf"
orchid    =       "#e672d3"
orange    =       "#e69972"
gray    =         "#7d7986"
light-gray   =    "#b1afb6"
light-red     =   "#e67299"
light-green   =   "#99e672"
light-yellow  =   "#e6bf72"
light-blue    =   "#7299e6"
light-magenta =   "#bf72e6"
light-cyan    =   "#72e6bf"
light-orchid =    "#e672d3"
white   =         "#ffffff"
old-green = "#68228B"
bg0 = "#0b0910"
bg1 = "#373049"
bg2 = "#3b344e"
bg3 = "#423a58"
bg4 = "#473e5f"
fg = "#ffffff"
