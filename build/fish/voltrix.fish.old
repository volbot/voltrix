function voltrix                
    set black   '0b0910'              
    set white   'ffffff'       
    set dgray   '382e52'       
    set lgray   'b1afb6'       
    set red     'e67299'           
    set green   '99e672'       
    set blue    '7299e6'         
    set yellow  'e6bf72'     
    set magenta 'bf72e6'   
    set cyan    '72e6bf'         
end
